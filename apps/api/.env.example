# Application
PORT=4000
NODE_ENV=development
TIMEZONE=Africa/Cairo

# Docker servise postgres database connection string
DATABASE_URL=postgresql://checkpoint_user:MyStrongPassword_2026_X9@localhost:5432/checkpoint_db?schema=public
# Neon PostgreSQL Database
# DATABASE_URL: Pooled connection string (with -pooler in hostname) for app queries
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct connection string (without -pooler) for Prisma schema migrations
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].neon.tech/neondb?sslmode=require"

# Redis (auxiliary: throttling & BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_ACCESS_SECRET="checkpoint-dev-jwt-access-secret-replace-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30
